#include <Adafruit_NeoPixel.h>

#define PIN 6
#define NUM_LEDS 50

Adafruit_NeoPixel strip(NUM_LEDS, PIN, NEO_GRB + NEO_KHZ800);

void setup() {
  strip.begin();

  // Set all LEDs to white
  for(int i = 0; i < NUM_LEDS; i++) {
    strip.setPixelColor(i, strip.Color(255, 255, 255));
  }

  strip.show();
}

